<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_day_image" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="16dp"
        android:baselineAligned="false">

        <!-- მარცხენა მხარე: ამინდი -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start|center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_location"
                    android:layout_marginEnd="4dp"
                    android:tint="@android:color/white" />
                <TextView
                    android:id="@+id/widget_city"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="თბილისი"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowRadius="2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">
                <ImageView
                    android:id="@+id/widget_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/clear_day" />
                <TextView
                    android:id="@+id/widget_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24°"
                    android:textColor="@android:color/white"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:shadowColor="#80000000"
                    android:shadowRadius="2" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="მოწმენდილი"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:alpha="0.9"
                android:layout_marginTop="2dp"
                android:shadowColor="#80000000"
                android:shadowRadius="1" />
        </LinearLayout>

        <!-- მარჯვენა მხარე: საათი და თარიღი -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end|center_vertical">

            <TextClock
                android:id="@+id/widget_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:textColor="@android:color/white"
                android:textSize="44sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:shadowColor="#80000000"
                android:shadowRadius="4" />

            <TextClock
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="d MMMM, EEEE"
                android:format24Hour="d MMMM, EEEE"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:shadowColor="#80000000"
                android:shadowRadius="2" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
